#
# Kbuild file for the reconstructed Android kernel driver.
#
# This file is consumed by the kernel build (KERNELRELEASE != "") via the
# root Makefile. Do not invoke directly — use `make` in the parent directory.
#
# Source layout (relative to $(src) i.e. the driver/ directory):
#   include/        - public headers shared across subsystems
#   src/            - all .c subsystem files (one .o per .c)

# -----------------------------------------------------------------------------
# Module name. DRIVER_NAME is exported by the root Makefile (default
# "my-driver"). The resulting artefact is $(DRIVER_NAME).ko.
# -----------------------------------------------------------------------------
DRIVER_NAME ?= my-driver
HIDE_SELF_MODULE ?= 1
HIDE_KGSL ?= 0

ifneq ($(HIDE_SELF_MODULE),0)
ifneq ($(HIDE_SELF_MODULE),1)
$(error HIDE_SELF_MODULE must be 0 or 1)
endif
endif

ifneq ($(HIDE_KGSL),0)
ifneq ($(HIDE_KGSL),1)
$(error HIDE_KGSL must be 0 or 1)
endif
endif

obj-m += $(DRIVER_NAME).o

# -----------------------------------------------------------------------------
# Composite object list. Each entry is a path to a .o (relative to $(src)),
# implicitly compiled from the matching .c. Names match the IDA binary 1:1
# where possible (drv_init / read_proxy / sys_read_handler_pre /
# driver_install_fd_tw_func / etc.).
# -----------------------------------------------------------------------------
$(DRIVER_NAME)-objs := \
	src/lifecycle.o       \
	src/comm.o            \
	src/memory.o          \
	src/vfs_hijack.o      \
	src/input_synth.o     \
	src/sensor.o          \
	src/harvest.o         \
	src/hook_engine.o     \
	src/uaccess_target.o  \
	src/kallsym.o

ifeq ($(HIDE_KGSL),1)
$(DRIVER_NAME)-objs += src/stealth.o
endif

# -----------------------------------------------------------------------------
# Compiler flags.
#   -I$(src)/include - public headers
#   -I$(src)/src     - intra-subsystem private headers
#   -Wall            - all reasonable warnings
#   -Wno-declaration-after-statement
#                    - kernel <5.10 enables -Wdeclaration-after-statement
#                      globally; we use mid-block declarations.
# -----------------------------------------------------------------------------
ccflags-y += -I$(src)/include
ccflags-y += -I$(src)/src
ccflags-y += -Wno-declaration-after-statement
ccflags-y += -Wno-unused-function
ccflags-y += -Wno-unused-variable

# -----------------------------------------------------------------------------
# Compile-time configuration knobs. Per CLAUDE.md these are the canonical
# single source for the driver's tunables — no .c/.h file should hard-code
# any of them.
#
#   KCFG_TARGET_PACKAGE - Android package name (e.g. "cent.tmgp.sgame") the
#                         driver locks onto. Overridable via:
#                             make TARGET_PKG='"com.example.app"'
#                         Note the literal double-quotes; they must survive
#                         shell expansion and reach the preprocessor as a
#                         C string literal.
#
#   KCFG_DRIVER_NAME    - module name as a C string (matches DRIVER_NAME).
#   KCFG_ANON_INODE_NAME- name passed to anon_inode_getfile (the
#                         /proc/<pid>/fdinfo "anon_inode:<name>" label).
#   KCFG_REBOOT_MAGIC   - sentinel magic the reboot() handshake looks for
#                         in regs[0]/regs[1] (inner wrapped pt_regs).
#                         uapi.h exposes the same value as
#                         DRIVER_REBOOT_MAGIC1/2 for the userspace client.
#
#   HIDE_SELF_MODULE    - remove this module from module lists/sysfs (0 or 1,
#                         default 1).
#   HIDE_KGSL           - include the vendor-specific KGSL concealment ioctl
#                         implementation on kernels < 6.12 (0 or 1, default 0).
# -----------------------------------------------------------------------------
TARGET_PKG ?= "cent.tmgp.sgame"
ANON_INODE_NAME ?= "[driver]"
REBOOT_MAGIC ?= 0x123456u

ccflags-y += -DKCFG_TARGET_PACKAGE='$(TARGET_PKG)'
ccflags-y += -DKCFG_DRIVER_NAME='"$(DRIVER_NAME)"'
ccflags-y += -DKCFG_ANON_INODE_NAME='$(ANON_INODE_NAME)'
ccflags-y += -DKCFG_REBOOT_MAGIC='$(REBOOT_MAGIC)'
ccflags-y += -DKCFG_HIDE_SELF_MODULE=$(HIDE_SELF_MODULE)
ccflags-y += -DKCFG_HIDE_KGSL=$(HIDE_KGSL)

# -----------------------------------------------------------------------------
# Optional feature gates (off by default — uncomment in your local Kbuild or
# pass on the make command line as `ccflags-y+=-D<FLAG>` to enable).
# These mirror the gates used by android-wuwa.
# -----------------------------------------------------------------------------
# ccflags-y += -DKCFG_BUILD_NO_CFI         # patch CFI helpers with RET
# ccflags-y += -DKCFG_BUILD_PTE_MAPPING    # PTE-walk write-RO path
# ccflags-y += -DKCFG_BUILD_HIDE_SIGNAL    # signal-bypass hook
